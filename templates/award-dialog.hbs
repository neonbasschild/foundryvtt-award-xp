<div class="award-xp-form-content">
    <p class="note">{{localize "AWARD_XP.DialogNote" count=characterCount}}</p>
    
    <div class="form-group">
        <label for="xpAmount">{{localize "AWARD_XP.AmountLabel"}}</label>
        <div class="form-fields">
            <input type="number" id="xpAmount" name="xpAmount" placeholder="0" min="1" required autofocus />
        </div>
    </div>

    <div class="form-group">
        <label for="splitXp">{{localize "AWARD_XP.SplitLabel"}}</label>
        <div class="form-fields">
            <input type="checkbox" id="splitXp" name="splitXp" checked />
        </div>
    </div>

    <footer class="form-footer">
        <button type="submit" data-action="submit" class="dialog-button positive">
            <i class="fas fa-check"></i> {{localize "AWARD_XP.Confirm"}}
        </button>
    </footer>
</div>